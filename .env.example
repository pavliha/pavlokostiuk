# Analytics. Both must be set or PostHog stays off entirely (no partial init).
# Create a project at posthog.com, then read the key from Project Settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# NOTE: these are NEXT_PUBLIC_*, so they are inlined at BUILD time into the static
# export. A .env on your machine does not reach the deployed site — pass them as
# docker build --build-arg, or set them as build arguments in Dokploy.

# Internal area (/internal). Runtime variables: set them as Dokploy environment variables,
# not build args. INTERNAL_DB_PATH must point into a mounted volume.
INTERNAL_PASSWORD=
INTERNAL_SESSION_SECRET=
INTERNAL_INGEST_TOKEN=
INTERNAL_DB_PATH=/data/internal.db
TWENTY_API_URL=https://crm.aircast.one
TWENTY_API_KEY=
