# Analytics. Both must be set or PostHog stays off entirely (no partial init).
# Create a project at posthog.com, then read the key from Project Settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Where the newsletter form POSTs {"email","source"} and the prototype form POSTs
# {"email","sell","link","source"} as JSON.
# Any endpoint returning 2xx works — Buttondown, Formspree, ConvertKit, your own.
# Until this is set the form tells the visitor it failed rather than pretending.
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=

# NOTE: these are NEXT_PUBLIC_*, so they are inlined at BUILD time into the static
# export. A .env on your machine does not reach the deployed site — pass them as
# docker build --build-arg, or set them as build arguments in Dokploy.
